#!/usr/bin/env bash

# Compiles a Fennel script into a standalone executable with Fennel's own
# --compile-binary, linking the frork engine in as a native module.
#
#   bin/compile-binary <target> <script.fnl> <output>
#
# <target> is a Rust target triple; anything other than the host is
# cross-compiled with zig. Needs FENNEL (the Fennel CLI, not the vendored
# library) and LUA_SRC (a Lua 5.4 source directory).

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

readonly TARGET="$1"
readonly SCRIPT="$2"
OUTPUT="$(realpath -m "$3")"
readonly OUTPUT
readonly BUILD="$PWD/target/compile-binary/$TARGET"
LLVM_BIN="$(rustc --print sysroot)/lib/rustlib/$(rustc -vV | sed -n 's/^host: //p')/bin"
readonly LLVM_BIN

main() {
    local cc lua_defs
    case "$TARGET" in
        *-apple-darwin)
            cc="zig cc -target ${TARGET%%-*}-macos"
            lua_defs=-DLUA_USE_MACOSX
            ;;
        *-linux-*)
            cc="zig cc -target ${TARGET%%-*}-linux-gnu"
            lua_defs=-DLUA_USE_LINUX
            ;;
        *)
            echo "unsupported target: $TARGET" >&2
            exit 1
            ;;
    esac

    # The engine, as a static Lua module that expects its host to provide Lua.
    cargo rustc --quiet -p frork --release --target "$TARGET" --crate-type staticlib
    local frork_lib="$PWD/target/$TARGET/release/libfrork.a"
    local native_libs
    native_libs="$(cargo rustc --quiet -p frork --release --target "$TARGET" \
        --crate-type staticlib -- --print native-static-libs 2>&1 |
        sed -n 's/.*native-static-libs: //p')"
    # zig has no libiconv for macOS; std references none of it.
    native_libs="${native_libs//-liconv/}"

    # The host Lua the module links against.
    mkdir -p "$BUILD"
    local src
    for src in "$LUA_SRC"/*.c; do
        case "$(basename "$src")" in lua.c | luac.c) continue ;; esac
        $cc -O2 "$lua_defs" -c "$src" -o "$BUILD/$(basename "$src" .c).o"
    done
    rm -f "$BUILD/liblua.a"
    "$LLVM_BIN/llvm-ar" rcs "$BUILD/liblua.a" "$BUILD"/*.o

    # Run from the script's directory so its modules and macros resolve.
    cd "$(dirname "$SCRIPT")"
    CC="$cc" NM="$LLVM_BIN/llvm-nm" CC_OPTS="$native_libs" \
        "$FENNEL" --compile-binary "$(basename "$SCRIPT")" "$OUTPUT" \
        "$BUILD/liblua.a" "$LUA_SRC" --native-module "$frork_lib"
}

main
